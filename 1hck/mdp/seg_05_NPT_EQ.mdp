; This gromacs .mdp file was generated
; as /Users/jessicaflowers/Desktop/winter_rotation/GROMACS/1hck_110/1hck_110/gromacs/seg_05_NPT_EQ.mdp
; by /Users/jessicaflowers/Desktop/winter_rotation/GROMACS/1hck_110/1hck_110/gromacs/dynamics-parameter-generation.py
; on 2026-01-24 08:39:12.221402

; input handling
gen-vel                  = no
continuation             = yes

; integration
integrator               = md
dt                       = 0.002
nsteps                   = 2500000
tinit                    = 300.0
mass-repartition-factor  = 1

; bonded interactions
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

; neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; electrostatics
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = cut-off
vdw-modifier             = force-switch
rvdw-switch              = 1
rvdw                     = 1.2

; restraints
define                   = -DPOSRES -DPOSRES_FC_BB=2000 -DPOSRES_FC_SC=2000 -DPOSRES_FC_SOD=0 -DPOSRES_FC_CLA=0 -DPOSRES_FC_TIP3=0

; thermostat
tcoupl                   = v-rescale
tc_grps                  = System
tau-t                    = 1
ref-t                    = 310.15

; barostat
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau-p                    = 5
ref-p                    = 1.01325
compressibility          = 4.5e-05
refcoord-scaling         = com

; output control; frequencies in steps
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 5000
