; This gromacs .mdp file was generated
; as /Users/jessicaflowers/Desktop/winter_rotation/GROMACS/3g33_110/3g33_110/gromacs/seg_02_NVT_EQ.mdp
; by /Users/jessicaflowers/Desktop/winter_rotation/GROMACS/3g33_110/3g33_110/gromacs/dynamics-parameter-generation.py
; on 2026-01-24 08:29:12.547042

; input handling
; NOTE: changed gen-vel to 'no' so that pre-existing velocities in the input
; gro (e.g. seg_01_PERT.gro) are preserved instead of being re-generated here.
gen-vel                  = no
gen-temp                 = 310.15
gen-seed                 = -1
continuation             = no

; integration
integrator               = md
dt                       = 0.002
nsteps                   = 50000
tinit                    = 0
mass-repartition-factor  = 1

; bonded interactions
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

; neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; electrostatics
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = cut-off
vdw-modifier             = force-switch
rvdw-switch              = 1
rvdw                     = 1.2

; restraints
define                   = -DPOSRES -DPOSRES_FC_BB=4000 -DPOSRES_FC_SC=4000 -DPOSRES_FC_SOD=400 -DPOSRES_FC_CLA=400 -DPOSRES_FC_TIP3=400

; thermostat
tcoupl                   = v-rescale
tc_grps                  = System
tau-t                    = 1
ref-t                    = 310.15

; output control; frequencies in steps
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 5000
